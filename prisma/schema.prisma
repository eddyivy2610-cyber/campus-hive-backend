generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum MessageVisibility {
  EVERYONE
  CAMPUS
  NO_ONE
}

enum ProfileVisibility {
  EVERYONE
  CAMPUS
  NO_ONE
}

enum ContactChannel {
  IN_APP
  WHATSAPP
}

model User {
  id        String      @id @default(cuid())
  email     String   @unique
  username  String   @unique
  fullName  String
  displayName String?

  profileImage String?

  campusId  String?
  campus    campus? @relation("UserCampus", fields: [campusId], references: [id])
  major     String?
  majorYear String?
  bio       String?

  whoCanMessageMe MessageVisibility @default(EVERYONE)
  profileVisibility ProfileVisibility @default(EVERYONE)
  contactChannel ContactChannel @default(IN_APP)
  showOnlineStatus Boolean @default(true)
  showMilestoneAchievements Boolean @default(true)

  passwordHash  String

  campusAdded campus[]  @relation("CampusAdded")

  role      Role          @default(BUYER)
  accountStatus AccountStatus @default(PENDING)
  tokenVersion Int   @default(0)
  storesCount Int    @default(0)
  verificationTokens VerificationToken[]
  isEmailVerified Boolean @default(false)

  sessions Session[]
  stores   Store[]
  listings Listing[]
  follows  Follow[]
  buyerOrders  Order[] @relation("OrderBuyer")
  sellerOrders Order[] @relation("OrderSeller")
  reviews      Review[]
  conversationsA Conversation[] @relation("ConversationParticipantA")
  conversationsB Conversation[] @relation("ConversationParticipantB")
  messages       Message[]
  notifications  Notification[]
  preferences    UserPreference?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  passwordUpdatedAt DateTime @default(now())
}

enum TokenType {
  EMAIL_VERIFICATION_SIGNUP
  EMAIL_VERIFICATION_PASSWORD_RESET
}

model VerificationToken {
  id        String      @id @default(cuid())
  token     String   @unique
  otpHash       String  
  userId    String
  type      TokenType
  user      User     @relation(fields: [userId], references: [id])
  verified   Boolean  @default(false)
  verifiedAt DateTime?
  consumedAt DateTime?
  failedAttempts Int  @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  otpHashUpdatedAt DateTime @default(now())
}

model campus {
  id        String      @id @default(cuid())
  name      String   @unique
  university String
  location  String
  createdAt DateTime @default(now())

  users     User[] @relation("UserCampus")

  addedBy   User     @relation("CampusAdded", fields: [addedById], references: [id])
  addedById String

  updatedAt DateTime @updatedAt
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

model Session {
  id String @id @default(cuid())
  familyId String @default(cuid())
  refreshTokenHash String? @unique

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  status SessionStatus @default(ACTIVE)
  refreshTokens RefreshToken[]

  expiresAt DateTime
  lastUsedAt DateTime @default(now())

  ipAddress String?
  lastKnownLat Float?
  lastKnownLong Float?
  latLongUpdatedAt DateTime?
  userAgent String?
  pushToken    String?
  platform         DevicePlatform?
  appVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([familyId])

}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  sessionId String
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  familyId  String
  usedAt    DateTime?
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([sessionId])
  @@index([familyId])
}

model Store {
  id                String   @id @default(cuid())
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name              String
  slug              String   @unique
  slugLower         String   @unique
  description       String?
  category          String?
  campus            String?
  operatingLocation String?
  logo              String?
  coverImage        String?
  storeType         String   @default("student_store")
  isVerified        Boolean  @default(false)
  verificationType  String?
  vacationMode      Boolean  @default(false)
  status            String   @default("active")
  suspensionReason  String?
  followersCount    Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  listings          Listing[]
  follows           Follow[]

  @@index([ownerId])
  @@index([status])
}

model Listing {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  price       Float
  category    String?
  campus         String?
  location       String?
  images         String[] @default([])
  condition      String?
  listingType    String   @default("product")
  serviceDetails Json?
  slug           String?  @unique
  status         String   @default("active")
  pausedBy    String?
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([storeId])
  @@index([sellerId])
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  follower   User     @relation(fields: [followerId], references: [id], onDelete: Cascade)
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([followerId, storeId])
  @@index([storeId])
}

model Order {
  id          String   @id @default(cuid())
  buyerId     String
  buyer       User     @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      User     @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  storeId     String?
  status      String   @default("processing")
  totalAmount Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews     Review[]

  @@index([buyerId])
  @@index([sellerId])
}

model Review {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  sellerId   String
  rating     Int
  comment    String
  createdAt  DateTime @default(now())

  @@unique([reviewerId, orderId])
  @@index([sellerId])
}

model Conversation {
  id           String    @id @default(cuid())
  participantA String
  participantB String
  storeId      String?
  context      Json?
  userA        User      @relation("ConversationParticipantA", fields: [participantA], references: [id], onDelete: Cascade)
  userB        User      @relation("ConversationParticipantB", fields: [participantB], references: [id], onDelete: Cascade)
  messages     Message[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([participantA, participantB])
  @@index([participantA])
  @@index([participantB])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model UserPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme              String   @default("system")
  homeFeedPreference String   @default("popular")
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @default("general")
  title     String
  message   String
  link      String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, isRead, createdAt(sort: Desc)])
}

model Banner {
  id             String    @id @default(cuid())
  placement      String    @default("homepage_hero")
  headline       String
  description    String?
  ctaLabel       String?
  ctaUrl         String?
  imageUrl       String
  mobileImageUrl String?
  imageAlt       String?
  targetCategory String?
  status         String    @default("published")
  priority       Int       @default(0)
  startAt        DateTime?
  endAt          DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([placement, status, priority(sort: Desc)])
}

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String?
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([targetType, targetId])
}

model Report {
  id             String    @id @default(cuid())
  reporterId     String
  targetType     String
  targetId       String
  reason         String
  details        String?
  status         String    @default("open")
  resolutionNote String?
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([targetType, targetId])
}

model SellerApplication {
  id                String    @id @default(cuid())
  userId            String
  storeId           String?
  businessName      String
  category          String?
  campus            String?
  operatingLocation String?
  studentIdUrl      String?
  notes             String?
  status            String    @default("pending")
  reviewNote        String?
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([userId])
}
