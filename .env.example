PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/campus-market?retryWrites=true&w=majority
AUTH_SECRET=your_super_secret_min_32_bytes_key_here
JWT_SECRET=your_super_secret_min_32_bytes_key_here
ADMIN_REGISTRATION_KEY=your_secure_admin_registration_key_here
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
NODE_ENV=production

# Email & SMTP Credentials (Google App Password / SMTP Relay)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_verified_service_email@gmail.com
SMTP_PASSWORD=your_rotated_google_app_password

USE_CLUSTERING=false
